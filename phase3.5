Yes. Let's build the QNX TCP server now.

The server will listen on port 5000 and wait for the ESP32.

1. Create tcp_server.c

In your QNX project, create a C source file named:

tcp_server.c

Use this code:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define BUFFER_SIZE 256

int main(void)
{
    int server_fd;
    int client_fd;
    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;
    socklen_t client_len = sizeof(client_addr);

    char buffer[BUFFER_SIZE];

    /* Create TCP socket */
    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return EXIT_FAILURE;
    }

    /* Allow address reuse */
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    /* Configure server */
    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(PORT);

    /* Bind */
    if (bind(server_fd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {

        perror("bind");
        close(server_fd);
        return EXIT_FAILURE;
    }

    /* Listen */
    if (listen(server_fd, 5) < 0) {
        perror("listen");
        close(server_fd);
        return EXIT_FAILURE;
    }

    printf("====================================\n");
    printf(" QNX PATIENT MONITOR TCP SERVER\n");
    printf("====================================\n");
    printf("Listening on TCP port %d...\n", PORT);

    while (1) {

        printf("Waiting for ESP32...\n");

        client_fd = accept(server_fd,
                           (struct sockaddr *)&client_addr,
                           &client_len);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        printf("ESP32 connected!\n");

        while (1) {

            memset(buffer, 0, sizeof(buffer));

            int bytes_received =
                recv(client_fd, buffer,
                     sizeof(buffer) - 1, 0);

            if (bytes_received <= 0) {
                printf("ESP32 disconnected.\n");
                break;
            }

            buffer[bytes_received] = '\0';

            printf("Received: %s", buffer);
            fflush(stdout);
        }

        close(client_fd);
    }

    close(server_fd);

    return EXIT_SUCCESS;
}
2. Build it

Build the QNX project in Momentics.

You should get an executable such as:

tcp_server
3. Run it on QNX

Open your QNX SSH terminal and run:

./tcp_server

You should see:

====================================
 QNX PATIENT MONITOR TCP SERVER
====================================
Listening on TCP port 5000...
Waiting for ESP32...

That means the server is ready.

4. Don't connect the ESP32 yet

First make sure the QNX server starts successfully.

If you get an error such as:

bind: Address already in use

or

socket: ...

send me the exact error.

Once you see Listening on TCP port 5000..., we'll make the ESP32 connect to 10.0.0.1:5000 and send the ECG data.
